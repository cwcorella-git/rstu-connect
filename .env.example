# RSTU Connect Environment Variables Template
# Copy this to .env.local and fill in your values

# ===========================================
# SUPABASE (Required for data loading scripts)
# ===========================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===========================================
# SOCKET.IO CHAT SERVER
# ===========================================
# Production URL (next.config.js provides default, GitHub Actions overrides)
NEXT_PUBLIC_SOCKETIO_URL=https://rstu-chat-server.onrender.com

# ===========================================
# BOOTSTRAP ADMIN (Optional)
# ===========================================
# Secret code to bootstrap first admin account
# WARNING: This is embedded in the client bundle for static sites
# Leave empty to disable bootstrap functionality
NEXT_PUBLIC_BOOTSTRAP_ADMIN_CODE=

# ===========================================
# MATRIX INTEGRATION (Optional)
# ===========================================
# For Matrix chat integration (if enabled)
# MATRIX_ACCESS_TOKEN=
# MATRIX_USER_ID=

# ===========================================
# LEGACY ADMIN AUTH (Deprecated)
# ===========================================
# SHA-256 hash of legacy admin password
# Not recommended - use profile-based auth instead
# NEXT_PUBLIC_LEGACY_ADMIN_HASH=

# ===========================================
# LOCAL DEVELOPMENT DATABASE (Optional)
# ===========================================
# For metadata enrichment scripts that connect to local postgres
# LOCAL_PG_URL=postgresql://user:pass@localhost:5432/database
# Or use individual settings:
# LOCAL_PG_HOST=localhost
# LOCAL_PG_PORT=5432
# LOCAL_PG_DATABASE=veritable_games
# LOCAL_PG_USER=postgres
# LOCAL_PG_PASSWORD=

# ===========================================
# VAPID KEYS (For relay-server push notifications)
# ===========================================
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:contact@example.com

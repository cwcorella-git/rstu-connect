# Environment variables (NEVER commit tokens/secrets!)
.env
.env.local
.env.production.local
.env.development.local

# Database files (too large for git)
*.db
data/databases/
data/*.db

# Output files
data/extracted_*.csv
data/matrix_rooms_created.json
data/top_complexes_for_matrix.csv

# Next.js
node_modules/
.next/
out/
/build/
dist/
*.tsbuildinfo
next-env.d.ts

# Auto-generated files (regenerated by npm run build)
public/documents/
public/version-info.json

# Netlify (auto-generated files)
.netlify/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/
test-results/

# Old static exports (use out/ instead)
_next/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archive (structure tracked, new large files ignored)
archive/analysis-reports/*.json
archive/screenshots/*.png
